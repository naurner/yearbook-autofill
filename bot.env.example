# Скопируйте в bot.env и заполните. bot.env не попадает в git.
# Токен бота: создайте бота у @BotFather в Telegram (/newbot) и вставьте токен сюда.
BOT_TOKEN=
# Ваш Telegram id (узнать: написать @userinfobot). Несколько — через запятую.
ADMIN_IDS=
# Где бот хранит базу, скачанные фото и превью (по умолчанию bot_data рядом с vignette.py).
DATA_DIR=
# Сборка для печати из бота: auto (если на этом компьютере есть Photoshop), yes, no.
PHOTOSHOP=auto
# Связь с CRM Lumi (необязательно). Та же Google Таблица, что у CRM: ID из её адреса
# docs.google.com/spreadsheets/d/<ID>/edit и файл ключа сервисного аккаунта CRM
# (на Mac: CRM_Lumi/config/service_account.json — скопируйте его сюда, например в autofill/crm_key.json).
CRM_SHEET_ID=
CRM_KEY_FILE=crm_key.json
# Лист с заказами (по умолчанию «Заказы»).
CRM_WORKSHEET=
